#!/usr/bin/env bash
# 假 claude：setup-token 模擬實測輸出格式；-p 模擬驗證 probe。
# 場景檔放在同目錄：setup-token 在清空環境後執行，不能靠 env 傳。
HERE="$(cd "$(dirname "$0")" && pwd)"
record_env_names() { compgen -e | sort > "$HERE/$1"; }
case "${1:-}" in
  setup-token)
    record_env_names setup-token.env-names
    [ -f "$HERE/scenario-no-url" ] && { sleep 600; exit 1; }
    # scenario-ansi：URL / token 前後夾顏色碼（真 TUI 會這樣輸出）
    on=""; off=""
    [ -f "$HERE/scenario-ansi" ] && { on=$'\e[1;36m'; off=$'\e[0m'; }
    printf "Browser didn't open? Use the url below to sign in:\n\n%s%s%s\n\nPaste code here if prompted > " "$on" "$(cat "$HERE/url.txt")" "$off"
    [ -f "$HERE/scenario-exit-early" ] && { sleep 1; exit 1; }
    IFS= read -r code
    printf '%s' "$code" > "$HERE/received-code"
    if [ "$code" = "$(cat "$HERE/good-code.txt")" ]; then
      printf '\nLong-lived authentication token created successfully!\n\nYour OAuth token (valid for 1 year):\n\n%s%s%s\n\nStore this token securely.\n' "$on" "$(cat "$HERE/token.txt")" "$off"
      exit 0
    fi
    printf '\nOAuth error: Invalid code\n'
    exit 1
    ;;
  -p)
    record_env_names "probe.$$.env-names"
    if [ -n "${CLAUDE_CODE_OAUTH_TOKEN:-}" ] && [ "$CLAUDE_CODE_OAUTH_TOKEN" = "$(cat "$HERE/probe-good-token.txt" 2>/dev/null)" ]; then
      echo OK; exit 0
    fi
    echo 'Failed to authenticate. API Error: 401 OAuth access token is invalid.'
    exit 1
    ;;
esac
exit 2
